{
  "expo": {
    "name": "NutriScan",
    "slug": "nutriscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF5B00"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nutriscan.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF5B00"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "nutriscan",
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriScan accesses your photos to analyze meal nutrition.",
          "cameraPermission": "NutriScan accesses your camera to scan and analyze food dishes."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NutriScan requires camera access to scan and analyze food nutrition in real-time."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF5B00",
          "sounds": [
            "./assets/sounds/bell_chime.wav",
            "./assets/sounds/meal_success.wav"
          ],
          "defaultChannel": "meal-reminders"
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "2fb438cf-c5b0-42c3-b0be-202024508f8a"
      }
    }
  }
}
